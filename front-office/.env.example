# ── Required ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://frontoffice:frontoffice@localhost:5432/frontoffice
# Public base URL (used in widget snippet, review links, Stripe redirects)
APP_URL=http://localhost:3000
# Protects /api/cron/tick (follow-ups, reminders, review requests)
CRON_SECRET=change-me
# Encrypts per-business integration secrets (webhook signing). 32 bytes: `openssl rand -hex 32`
APP_ENCRYPTION_KEY=

# ── AI (optional – without a key the built-in rules engine is used) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Embeddings for semantic knowledge search (optional – full-text search is always on)
VOYAGE_API_KEY=

# ── Billing (optional) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Outbound channels (optional) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="AI Front Office <frontdesk@example.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Tests use a separate database
TEST_DATABASE_URL=postgres://frontoffice:frontoffice@localhost:5432/frontoffice_test

# Shared rate limiting across instances (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
