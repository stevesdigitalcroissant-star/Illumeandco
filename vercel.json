{
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/generation", "destination": "/Generation/index.html" },
    { "source": "/Generation", "destination": "/Generation/index.html" }
  ],
  "headers": [
    {
      "source": "/generation",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/Generation",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/Generation/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
